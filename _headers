# Always revalidate HTML and JS so deploys take effect immediately.
# (Stale cached JS was causing fixes to never load in the browser.)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
