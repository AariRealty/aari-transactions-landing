# =============================================================================
# Aari Transactions — Environment Variables
# =============================================================================
# Copy to .env.local for local dev. NEVER commit a real .env to git.
# Browser-side code reads SUPABASE_URL + SUPABASE_ANON_KEY from
# Website/js/supabase-config.js — those values are safe to expose because RLS
# policies are the actual access control.
# Server-side Edge Functions (Migration/functions/*) read everything below.
# =============================================================================

# --- Supabase (browser-safe) ---
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://fnlrgmuvtgwzjsihqxcn.supabase.co
SUPABASE_ANON_KEY=sb_publishable_OsZVC29HKhFAZRNVo3yKqQ_wM7r2ANd

# --- Supabase (server-only — NEVER ship to the browser) ---
# Auto-injected into Edge Function runtime by Supabase. Do NOT set manually
# via `supabase secrets set` — Supabase rejects it. Listed here for reference.
# SUPABASE_SERVICE_ROLE_KEY=<auto-injected>

# --- Stripe (Edge Function only) ---
# Set via: supabase secrets set STRIPE_WEBHOOK_SECRET=...
# From: Stripe Dashboard → Developers → Webhooks → click endpoint → Reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. Only needed if you want the stripe-webhook to look up balance
# transactions on charge.refunded events. The webhook works without it.
# Use a RESTRICTED key with read.charges, read.invoices, read.subscriptions.
# STRIPE_API_KEY=rk_live_...
